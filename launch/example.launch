<launch>
  <!-- Scene seen by the LiDAR and runtime parameters of every node. -->
  <arg name="world" default="$(find lidar_sim)/config/world.yaml"/>
  <arg name="params" default="$(find lidar_sim)/config/params.yaml"/>
  <!-- Node that moves the LiDAR: sim_drone (waypoint mission) or sim_motion (circle). -->
  <arg name="motion" default="sim_drone"/>
  <arg name="rviz" default="true"/>

  <!-- Node names must match the top-level keys of the parameter file. -->
  <rosparam command="load" file="$(arg params)"/>

  <node pkg="lidar_sim" type="sim_lidar" name="sim_lidar" output="screen">
    <param name="world_file" value="$(arg world)"/>
  </node>

  <node pkg="lidar_sim" type="$(arg motion)" name="$(arg motion)" output="screen"/>

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="rviz"
        args="-d $(find lidar_sim)/rviz/config.rviz">
    <!-- Skip the ROS Noetic end-of-life dialog shown at startup. -->
    <env name="DISABLE_ROS1_EOL_WARNINGS" value="1"/>
  </node>
</launch>
