<?xml version="1.0"?>
<package format="2">
  <name>lidar_sim</name>
  <version>0.0.0</version>
  <description>
    Simulation of a spinning LiDAR by ray casting against a world of geometric primitives,
    with simple motion models (circular trajectory, waypoint-following drone) to move the sensor.
  </description>

  <maintainer email="adrianomcr18@gmail.com">adrianomcr</maintainer>
  <license>TODO</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_ros</depend>
  <depend>visualization_msgs</depend>
  <depend>eigen</depend>
  <depend>yaml-cpp</depend>

  <exec_depend>rviz</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
</package>
